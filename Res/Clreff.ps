// Colour effects pass (gfx.color_effects): palette flashes and the visual filter LUT.
// Post shader: the engine puts its declarations in front of this text
// (uTexture, uAux, PostParams, texCoords, fragColor, sampleScreen; see
// OpenNeoUA_Parameter_Guide_EN.md, Graphics). Write only functions and main().

void main()
{
    vec4 clr = sampleScreen(uTexture, texCoords);
    vec3 base = clr.xyz * normclr + (1.0 - clr.xyz) * invclr;
    if (filterStrength > 0.0)
    {
        float lum = clamp(dot(base, vec3(0.2126, 0.7152, 0.0722)), 0.0, 1.0);
        float lutX = (lum * 255.0 + 0.5) / 256.0; // sample at texel center
        vec3 graded = texture(uAux, vec2(lutX, 0.5)).rgb;
        base = mix(base, graded, filterStrength);
    }
    fragColor = vec4(base, clr.w);
}
