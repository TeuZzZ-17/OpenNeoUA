#version 120

uniform sampler2D texture;
uniform vec3 normclr;
uniform vec3 invclr;
uniform ivec2 screenSize;
uniform sampler2D filterLut;
uniform float filterStrength;
uniform float atmosphereStrength;
uniform float atmosphereExposure;
uniform float atmosphereContrast;
uniform float atmosphereSaturation;
uniform float atmosphereVignette;

float uaLuma(vec3 c)
{
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main()
{
    vec2 uv = gl_TexCoord[0].xy;
    vec4 source = texture2D(texture, uv);

    // Preserve the engine's legacy palette flashes/inversion first.
    vec3 base = source.rgb * normclr + (1.0 - source.rgb) * invclr;
    float lum = clamp(uaLuma(base), 0.0, 1.0);

    // Keep OpenUA's existing luminance LUT/palette path intact.
    vec3 lutColor = texture2D(filterLut, vec2(lum, 0.5)).rgb;
    vec3 color = mix(base, lutColor, clamp(filterStrength, 0.0, 1.0));

    color *= atmosphereExposure;
    color = (color - 0.5) * atmosphereContrast + 0.5;

    float grey = max(uaLuma(color), 0.0);
    color = mix(vec3(grey), color, atmosphereSaturation);

    // v4: stronger cinematic toe. Midtones fall toward silhouette while the
    // brightest sky, explosions and energy remain readable.
    grey = clamp(uaLuma(color), 0.0, 1.0);
    float mappedLum = pow(grey, 1.20);
    float highlightKeep = smoothstep(0.68, 0.96, grey);
    mappedLum = mix(mappedLum, grey, highlightKeep * 0.38);
    color *= mappedLum / max(grey, 0.001);

    // Less cyan than v3. Shadows stay cool-neutral; contaminated olive/ochre
    // is carried mainly by midtones and highlights.
    float shadow = 1.0 - smoothstep(0.08, 0.48, mappedLum);
    float midtone = smoothstep(0.16, 0.43, mappedLum)
                  * (1.0 - smoothstep(0.56, 0.80, mappedLum));
    float highlight = smoothstep(0.50, 0.92, mappedLum);

    color *= mix(vec3(1.0), vec3(0.92, 0.95, 0.99), shadow * 0.30);
    color *= mix(vec3(1.0), vec3(1.025, 1.000, 0.91), midtone * 0.20);
    color *= mix(vec3(1.0), vec3(1.07, 1.015, 0.86), highlight * 0.34);

    // Soft shoulder: preserve luminous clouds without modern HDR bloom.
    color = max(color - vec3(0.006), vec3(0.0));
    color = pow(color, vec3(1.025));
    color = color / (vec3(1.0) + max(color - vec3(0.80), vec3(0.0)) * 0.38);

    vec2 size = max(vec2(screenSize), vec2(1.0));
    float aspect = size.x / size.y;
    vec2 edge = uv * 2.0 - 1.0;
    edge.x *= aspect;
    float vignette = smoothstep(0.38, 1.50, dot(edge, edge));
    color *= 1.0 - vignette * clamp(atmosphereVignette, 0.0, 1.0) * 0.34;

    color = mix(base, color, clamp(atmosphereStrength, 0.0, 1.0));
    gl_FragColor = vec4(clamp(color, 0.0, 1.0), source.a);
}
